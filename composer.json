{
	"name": "adminova/adminova",
	"description": "Modern look and one-screen overview for the WordPress/WooCommerce admin.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/Open-WP-Club/adminova",
	"authors": [
		{
			"name": "Open WP Club",
			"homepage": "https://github.com/Open-WP-Club",
			"role": "Organisation"
		},
		{
			"name": "Gabriel Kanev",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/Open-WP-Club/adminova/issues",
		"source": "https://github.com/Open-WP-Club/adminova"
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brain/monkey": "^2.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^10.0 || ^9.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^11.5 || ^12.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"test": [
			"@test:unit",
			"@test:monkey"
		],
		"test:unit": "phpunit",
		"test:monkey": "phpunit -c phpunit-monkey.xml.dist",
		"test:integration": "npm run test:integration",
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=1G"
	}
}
