<?xml version="1.0" encoding="UTF-8"?>
<!-- Pure-logic unit tests: no WordPress, a few hand-written function stubs. -->
<phpunit bootstrap="tests/unit/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true" failOnRisky="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include><directory>includes</directory></include>
	</source>
</phpunit>
